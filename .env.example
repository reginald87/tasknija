# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Prisma + SQLite)
# Relative path resolves against server/prisma/schema.prisma and is
# portable. In production, override with an absolute path or an external
# database URL, e.g.
#   DATABASE_URL="file:/var/lib/tasknija/prod.db"
#   or for Postgres: DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# Auth (custom JWT)
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN=7d
REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Google OAuth (web client ID — enables "Continue with Google").
# Get it from Google Cloud Console > APIs & Services > Credentials.
# Add http://localhost:5173 as an Authorized JavaScript origin (dev).
VITE_GOOGLE_CLIENT_ID=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Paystack)
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=

# Email (SMTP) — Gmail app password (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tasknija@gmail.com
SMTP_PASS=
EMAIL_FROM=TaskNija <tasknija@gmail.com>

# CORS / origin (production: set to your frontend domain, e.g. https://tasknija.com)
ALLOWED_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Password reset redirect (where users land after clicking the reset link in email)
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Platform fee (percent)
PLATFORM_FEE_PERCENT=2

# Logging
LOG_LEVEL=info

# Idempotency-key TTL cleanup (days; must be >= 1)
IDEMPOTENCY_RETENTION_DAYS=7

# Social OAuth (additional providers — add your client IDs to enable)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_FACEBOOK_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
